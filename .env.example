# Copy to .env for local dev, or set these as Variables on the Alternate Clouds service.
# Generate the four secrets with: python scripts/gen_secrets.py

# --- core ---
ENV=prod
APP_NAME=SocialAgent
APP_BASE_URL=https://socialagent-app.alternatefutures.ai
FRONTEND_URL=https://socialagent-app.alternatefutures.ai
PORT=8000
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- secrets (never commit real values) ---
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
MEDIA_SIGNING_SECRET=
INTERNAL_SHARED_SECRET=

# Emails allowed to open /app/admin (WhatsApp pairing). Comma separated.
ADMIN_EMAILS=

# --- AI (providers tried in order; only those with a key are used; no key at all = built-in rules).
# Claude edits in one structured call (fewest tokens); Gemini/Groq run a short tool-calling loop. ---
LLM_PROVIDERS=anthropic,groq,gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# auto = Groq Whisper when GROQ_API_KEY is set, else local faster-whisper
TRANSCRIBE_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
WHISPER_MODEL=small

# --- Instagram (Meta app > Instagram > API setup with Instagram login) ---
IG_APP_ID=
IG_APP_SECRET=
# IG_REDIRECT_URI defaults to ${APP_BASE_URL}/api/instagram/callback

# --- Facebook Page cross-posting (optional; Meta app > Facebook Login for Business) ---
FB_APP_ID=
FB_APP_SECRET=
# Configuration ID from Facebook Login for Business > Configurations (pages_show_list,
# pages_read_engagement, pages_manage_posts). Leave empty to fall back to plain scopes.
FB_LOGIN_CONFIG_ID=
# FB_REDIRECT_URI defaults to ${APP_BASE_URL}/api/facebook/callback

# --- optional ---
MAX_VIDEO_SECONDS=180
RENDER_CONCURRENCY=1
PUBLISH_DRY_RUN=false
LOG_LEVEL=warn
